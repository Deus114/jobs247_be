SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=recruitment
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_EMAIL_VERIFICATION_EXPIRATION=900000

# milliseconds: OTP sống 5 phút, gửi lại sớm nhất sau 60 giây
OTP_EXPIRATION=300000
OTP_RESEND_COOLDOWN=60000

SEED_ADMIN=true
# true = gửi email qua RabbitMQ queue; false = @Async trong app (không cần RabbitMQ)
MAIL_QUEUE_ENABLED=true

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

REDIS_HOST=localhost
REDIS_PORT=6379
# TTL cache (giây)
HOT_JOBS_CACHE_TTL_SECONDS=120
PROVINCES_CACHE_TTL_SECONDS=21600
INDUSTRY_GROUPS_CACHE_TTL_SECONDS=21600
EDUCATION_LEVELS_CACHE_TTL_SECONDS=21600
BUSINESS_CONFIG_CACHE_TTL_SECONDS=3600

AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# false = local HTTP; true = production HTTPS
AUTH_COOKIE_SECURE=false

# true = gửi push qua Firebase. File JSON chỉ để trên máy chủ, không commit.
FCM_ENABLED=false
FIREBASE_CREDENTIALS_PATH=jobs247-firebase-adminsdk.json
